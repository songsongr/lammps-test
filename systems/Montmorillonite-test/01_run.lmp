# 01_run.lmp — 蒙脱石模拟: 最小化→平衡→生产(MSD+RDF轨迹)
# 力场数值 (pair_coeff/bond/angle) 的单一真相源为 system.json atom_types
#   — 本脚本与之核对一致 (2026-09-04); 修改参数请改 system.json 后重建
# 体系构建: uv run python -m common.build Montmorillonite-test
# 2026-09-04 动力学修复: system.json cif_binding.oh_frac_z_max 0.296→0.2925
#   清除 16 个误分类顶氧幻影 H (H-Si 0.616 A, 库仑斥力爆炸根因) 后,
#   旧版 nve/limit 0.05 + langevin 的 4260K 伪稳态不再需要 —
#   改为 minimize + 正规 nve/langevin (v2-v5 修复失败的根因即缺陷接触仍在)

units           real
atom_style      full
bond_style      harmonic
angle_style     harmonic
special_bonds   lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
pair_style      lj/cut/coul/long 9.0 8.0
kspace_style    pppm 1.0e-4
boundary        p p p

read_data       system.data

group           O_fw          type 1 2 3
group           H_oh          type 4
group           Si            type 5
group           Al            type 6
group           Ca            type 7
group           Ow            type 8
group           Hw            type 9
group           framework     union O_fw H_oh Si Al
group           water         union Ow Hw

pair_coeff      1 1           0.15539   3.1655
pair_coeff      2 2           0.15539   3.1655
pair_coeff      3 3           0.15539   3.1655
pair_coeff      4 4           0.0       0.0
pair_coeff      5 5           1.84e-6   3.7064
pair_coeff      6 6           5.56e-6   4.2713
pair_coeff      7 7           0.23500   3.0950
pair_coeff      8 8           0.15539   3.1655
pair_coeff      9 9           0.0       0.0
# bond type 1 (554.13/1.0, CLAYFF O-H) 同时覆盖层间水 2x160 与骨架羟基 8 条 O-H 键
bond_coeff      1            554.13    1.0
angle_coeff     1             45.77  109.47

# ============================================================
# 阶段1: 能量最小化 (清除构建残差应力; 缺陷接触已除, cg 可收敛)
# ============================================================
print "=== STAGE1: MINIMIZATION ==="

thermo          1000
thermo_style    custom step temp pe ke etotal press fmax
min_style       cg
minimize        1.0e-6 1.0e-6 10000 100000

print "=== STAGE1 DONE ==="

# ============================================================
# 阶段2: NVE + Langevin 300K 平衡 (正规动力学, 无位移限速)
# ============================================================
print "=== STAGE2: RELAXATION ==="

reset_timestep  0
velocity        all create 300.0 12345
timestep        0.5

fix             f_nve all nve
fix             f_lang all langevin 300.0 300.0 10.0 12345

thermo          5000
thermo_style    custom step time temp pe ke etotal press fmax
run             50000
write_restart   checkpoint_stage1.restart
# write_restart — 检查点: 弛豫段完成态 (工作台可从此续跑)

print "=== STAGE2 DONE ==="

# ============================================================
# 阶段3: 生产模拟 + MSD
# ============================================================
print "=== STAGE3: PRODUCTION ==="

compute         m_wat water msd com yes
compute         m_Ca  Ca    msd com yes
compute         m_fw  framework msd com yes
fix             f_msd all ave/time 1000 1 1000 c_m_wat[4] c_m_Ca[4] c_m_fw[4] file msd.dat mode scalar

thermo          5000
thermo_style    custom step time temp pe ke etotal press fmax

# 输出轨迹 (每 200 步, 便于 RDF 后处理)
dump            d_prod all custom 200 prod.lammpstrj id type x y z xu yu zu
dump_modify     d_prod sort id

run             100000
write_restart   checkpoint_prod.restart
# write_restart — 检查点: 生产完成态

unfix           f_nve
unfix           f_lang
undump          d_prod
unfix           f_msd

print "=== SIMULATION DONE ==="
