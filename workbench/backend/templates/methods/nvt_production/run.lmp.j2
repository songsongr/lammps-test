# [generated] 本文件由方法模板 {{ method_id }} 渲染生成 (体系: {{ system.profile }})
# 重新渲染会覆盖本文件; 如需手改, 建议另存副本或在保存前确认覆盖提示。
# 体系参数 (组成/力场/来源) 的单一真相源为本项目 system.json。

# ============================================================
# {{ system.title | default("LAMMPS 模拟", true) }}
# ============================================================
# 模板: {{ method_id }} — 最小化 + NVT 平衡 + 生产 (9 板块规范)
# 体系 profile: {{ system.profile }} | 水模型: {{ system.water_model }}
# 温度: {{ params.temperature }} K | 时间步: {{ params.timestep_fs }} fs
# 平衡: {{ params.equil_steps }} 步 | 生产: {{ params.prod_steps }} 步
# 板块结构规范见 docs/workflows.md — 每个板块头说明其作用

# ============================================================
# 第 1 部分: 全局设置
# ============================================================

units                   real
# units real — real 单位制: 能量 kcal/mol, 长度 Å, 质量 g/mol, 时间 fs, 电荷 e, 温度 K
#   选择原因: 水模型与力场参数均以 kcal/mol / Å 惯例给出

atom_style              full
# atom_style full — 原子数据含 molecule-ID 与电荷 (水分子成键 + 库仑力都需要)

boundary                p p p
# boundary p p p — 三方向周期性边界; PPPM 长程静电要求全周期
#   z 方向留真空层减弱周期镜像干扰

# ============================================================
# 第 2 部分: 读入体系数据
# ============================================================

read_data               system.data
# read_data — 读入原子坐标/键/角/盒子/质量表 (由体系构建引擎从 system.json 生成)

# ============================================================
# 第 3 部分: 分组
# ============================================================
# 分组决定"谁被动过"——后续冻结/恒温/温度初始化都只作用于指定组

{% if surf_id %}
group                   surf type {{ surf_id }}
# group surf — 表面原子 (type {{ surf_id }} = {{ surf_name }}), 下一步冻结

fix                     f_fix surf setforce 0 0 0
# fix setforce 0 0 0 — 冻结表面: 每步把受力清零, 位置永不变
#   冻结底面是表面模拟标准做法, 避免表面漂移
{% endif %}
group                   water type {{ ow_id }} {{ hw_id }}
# group water — 水分子原子 (Ow={{ ow_id }}, Hw={{ hw_id }})

{% for ion in ion_types %}
group                   ion_{{ ion.name | lower }} type {{ ion.id }}
# group ion_{{ ion.name | lower }} — 离子 {{ ion.name }} ({{ ion.charge > 0 and "+" or "" }}{{ ion.charge }})
{% endfor %}
group                   mobile union water{% for ion in ion_types %} ion_{{ ion.name | lower }}{% endfor %}
# group mobile — 全部可移动原子; 恒温器只作用于这个组

# ============================================================
# 第 4 部分: 非键力场 (LJ + 库仑)
# ============================================================

pair_style              lj/cut/coul/long 9.0 8.0
# pair_style — LJ 12-6 (截断 8 Å) + 库仑 (短程 9 Å + 长程 PPPM)

kspace_style            pppm 1e-4
# kspace_style pppm 1e-4 — 长程静电 PPPM 求解, 力精度 1e-4 (标准值)

pair_modify             mix arithmetic
# pair_modify mix arithmetic — 交叉项混合规则: σ 取算术平均, ε 取几何平均
#   只写同种对 (I I), 交叉对 (I J) 自动生成

# --- 同种原子对 LJ 参数 (来源/置信度见注释; 数据源: system.json) ---
{% for t in system.atom_types %}
pair_coeff              {{ t.id }} {{ t.id }} {{ t.eps }} {{ t.sigma }}
#   type {{ t.id }} ({{ t.name }}): ε={{ t.eps }} kcal/mol, σ={{ t.sigma }} Å
#   来源: {{ t.source }} | 置信度: {{ t.confidence }}
{% if t.ref %}
#   参考: {{ t.ref }}
{% endif %}
{% if t.warning %}
#   ⚠ {{ t.warning }}
{% endif %}
{% endfor %}

# ============================================================
# 第 5 部分: 分子内力场 (刚性水)
# ============================================================

bond_style              harmonic
# bond_style harmonic — 简谐键势 E = K_b (r - r0)^2 (SPC/E 几何约束用)

bond_coeff              1 554.1349 1.0
# bond_coeff 1 — O-H 键: K_b=554.13, r0=1.0 Å (SPC/E 标准参数)

angle_style             harmonic
# angle_style harmonic — 简谐角势 E = K_a (θ - θ0)^2

angle_coeff             1 45.7696 109.47
# angle_coeff 1 — H-O-H 角: K_a=45.77, θ0=109.47° (四面体角)

special_bonds           lj 0.0 0.0 0.5 coul 0.0 0.0 0.5
# special_bonds — 分子内 1-2/1-3 非键完全排除, 1-4 减半 (SPC/E 标准设置)

# ============================================================
# 第 6 部分: 模拟控制参数
# ============================================================

neighbor                2.0 bin
# neighbor 2.0 bin — 近邻列表缓冲 2 Å, binning 算法

thermo_modify           lost ignore flush yes
# thermo_modify — lost ignore 忽略原子漂出警告; flush yes 实时刷新日志

thermo_style           custom step temp press density toteng
# thermo_style — 输出列含 density: 工作台平衡判据需要密度+总能量做末窗口漂移检验
#               (「热力学曲线」卡据此显示平衡质量胶囊)

thermo                  2000
# thermo 2000 — 平衡段热力学输出频率 (每 2000 步)

# ============================================================
# 第 7 部分: 能量最小化
# ============================================================
{% if params.do_minimize %}
print "=== MINIMIZATION ==="

min_style               cg
# min_style cg — 共轭梯度最小化 (大体系标准选择)

minimize                1e-4 1e-6 500 10000
# minimize — 消除初始构型的原子重叠与应力, 为 NVT 提供合理起点

print "=== MINIMIZATION DONE ==="
{% else %}
# (本次跳过能量最小化 — do_minimize=false)
{% endif %}

# ============================================================
# 第 7b 部分: SHAKE 约束 (必须在最小化之后、NVT 之前定义)
# ============================================================
# SHAKE 固定 O-H 键长与 H-O-H 角, 消除高频振动 → 步长可从 0.2 fs 提升到 {{ params.timestep_fs }} fs

fix                     fshake water shake 0.0001 20 100 b 1 a 1
# fix shake — 作用组 water; b 1 a 1 = 约束全部 bond/angle type 1

# ============================================================
# 第 8 部分: NVT 平衡
# ============================================================

print "=== NVT ==="

velocity                mobile create {{ params.temperature }} {{ params.velocity_seed }}
# velocity create — 按 Maxwell-Boltzmann 分布初始化速度 (种子固定可复现)

fix                     fnvt mobile nvt temp {{ params.temperature }} {{ params.temperature }} 100.0
# fix nvt — Nose-Hoover 恒温器, 阻尼 100 fs, 只耦合 mobile 组

timestep                {{ params.timestep_fs }}
# timestep — {{ params.timestep_fs }} fs (SHAKE 刚性水下的标准步长)

run                     {{ params.equil_steps }}
# run {{ params.equil_steps }} — NVT 平衡, 时长 {{ "%.1f" | format(params.equil_steps * params.timestep_fs / 1000.0) }} ps

print "=== NVT DONE ==="

# ============================================================
# 第 9 部分: 生产模拟 (产出轨迹)
# ============================================================

print "=== PRODUCTION ==="

dump                    dmp1 all custom {{ params.dump_interval }} prod.lammpstrj id type x y z
# dump — 每 {{ params.dump_interval }} 步输出一帧轨迹 prod.lammpstrj (VMD/OVITO 可读)
#   总帧数 ≈ {{ params.prod_steps }} / {{ params.dump_interval }} = {{ (params.prod_steps / params.dump_interval) | int }} 帧
#   物理时长: {{ "%.1f" | format(params.prod_steps * params.timestep_fs / 1000.0) }} ps

thermo_style           custom step temp press density toteng
# thermo_style — 同上, 生产段输出含 density

thermo                  5000
# thermo 5000 — 生产段热力学输出频率

run                     {{ params.prod_steps }}
# run {{ params.prod_steps }} — 生产模拟

print "=== PRODUCTION DONE ==="
# 日志出现此行 = 模拟正常结束
